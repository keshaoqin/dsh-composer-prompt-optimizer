{
  "name": "dsh-composer-prompt-optimizer",
  "version": "0.1.0",
  "description": "在 DeepSeek Harness 输入框中常驻一个提示词优化按钮：一键改写草稿、保留原文快照并可回退。A resident prompt-optimization button for the DeepSeek Harness composer with one-click rewrite and revert.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-optimizer",
    "prompt-enhancer",
    "composer"
  ],
  "type": "module",
  "license": "MIT",
  "author": "muxiaoke",
  "homepage": "https://github.com/keshaoqin/dsh-composer-prompt-optimizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshaoqin/dsh-composer-prompt-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/keshaoqin/dsh-composer-prompt-optimizer/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "prompts/system-prompt.txt",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "docs/DESIGN.md",
    "docs/MARKETPLACE.md",
    "docs/marketplace-entry.yml",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
