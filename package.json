{
  "name": "dsh-composer-prompt-optimizer",
  "version": "0.2.0",
  "description": "DSH 输入框常驻「优化提示词 / 回退原文」按钮：用输入框当前选中的模型就地改写草稿，原文随时可回退，失败时说明原因、错误码与处理办法。A resident Optimize / Revert button in the DSH composer that rewrites the draft with the model selected in that composer, keeps the original restorable, and explains any failure with a cause, an error code and how to recover.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-optimizer",
    "prompt-enhancer",
    "composer"
  ],
  "type": "module",
  "license": "MIT",
  "author": "muxiaoke",
  "homepage": "https://github.com/keshaoqin/dsh-composer-prompt-optimizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshaoqin/dsh-composer-prompt-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/keshaoqin/dsh-composer-prompt-optimizer/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "prompts/system-prompt.txt",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "docs/DESIGN.md",
    "docs/MARKETPLACE.md",
    "docs/marketplace-entry.yml",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
